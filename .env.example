PROJECT_NAME=my_website
NGINX_PORT=8001

# MariaDB
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=my_website
MYSQL_USER=wpuser
MYSQL_PASSWORD=wppassword

# Autofill by setup.sh
UID=1000
GID=1000

# Cloudflare Zero Trust Tunnel (production only — leave empty for local dev)
# See the production-release skill / README for setup steps.
CLOUDFLARE_TUNNEL_TOKEN=
PRODUCTION_DOMAIN=

# Backup (db + files) — see the backup skill / README "Backup" section
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=7
# host      -> schedule via a cron entry on the host (see the README/skill for an example)
# container -> runs the `backup` service added by docker-compose.prod.yml (make prod-up)
BACKUP_SCHEDULER=host
BACKUP_SCHEDULE_CRON=0 3 * * *
# Space-separated paths (relative to public_html/) to exclude from the files archive
BACKUP_EXCLUDE_PATHS=
# Remote destination for an optional sync after each backup — leave empty to disable
BACKUP_REMOTE_PATH=
# Command run as: $BACKUP_REMOTE_SYNC_CMD <BACKUP_PATH> <BACKUP_REMOTE_PATH> — swap for rclone (e.g. "rclone sync") if preferred
BACKUP_REMOTE_SYNC_CMD=rsync -az